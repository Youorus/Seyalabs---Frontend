NEXT_PUBLIC_SITE_URL=https://seyalabs.com
NEXT_PUBLIC_CONTACT_EMAIL=contact@seyalabs.com
# Set true only on the final public domain. Preview environments stay noindex.
SITE_INDEXABLE=false
# Optional token for a Search Console URL-prefix property; DNS validation also works.
GOOGLE_SITE_VERIFICATION=
# HTTPS webhook receiving validated JSON, e.g. n8n / CRM / transactional email.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=
# Optional distributed abuse protection (recommended for multi-instance hosting).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SECRET=
# True only behind a proxy that overwrites forwarded headers.
CONTACT_TRUST_PROXY=false
# For integration audits against a local production server; keep false when deployed.
CONTACT_ALLOW_LOCAL_PREVIEW=false
# GA4 loads only after explicit audience-measurement consent. Rebuild after changes.
NEXT_PUBLIC_ANALYTICS_ENABLED=true
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-K3MFCQHF4R
# Optional links: absent links are omitted from the UI.
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=
# Complete before production publication.
LEGAL_COMPANY_NAME=
LEGAL_COMPANY_FORM=
LEGAL_CAPITAL=
LEGAL_ADDRESS=
LEGAL_REGISTRATION=
LEGAL_VAT=
LEGAL_DIRECTOR=
LEGAL_HOST_NAME=
LEGAL_HOST_ADDRESS=
LEGAL_HOST_PHONE=
PRIVACY_RETENTION_MONTHS=12
